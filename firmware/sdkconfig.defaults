CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# 1 ms tick so the call-sequence timings in config.h are exact.
CONFIG_FREERTOS_HZ=1000
# Bluetooth: Bluedroid, BLE-only controller (HFP dropped 2026-11-07; NimBLE would be smaller, no need yet).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
# Bluedroid is large: 1.5 MB app partition; the rest is the sound bank (partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
